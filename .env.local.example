# Copy to .env.local — never commit .env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>          # Supabase → Settings → API (publishable/anon)
SUPABASE_SERVICE_ROLE_KEY=<service role key>      # server + scripts only. NEVER prefix with NEXT_PUBLIC_
RESEND_API_KEY=<resend key>                        # transactional email
EMAIL_FROM="Bookings <bookings@yourdomain.com>"
CRON_SECRET=<random string>                        # Vercel cron → /api/cron/reminders
# Optional
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_EMAIL=<where listing requests are emailed>
